# === LLM Configuration ===
# Primary engine: Google Gemini. Get a key at https://aistudio.google.com/app/apikey
# NEVER commit a real key. Copy this file to `.env` and put your real key there.
GEMINI_API_KEY="AQ.Ab8RN6Isx2iTEJYhm2sTDcEK-4oLmvwlAcfRd8X64eSzTWHM_Q"
GEMINI_MODEL=gemini-1.5-flash

# Fallback local engine: Ollama (used automatically if Gemini call fails/quota exceeded)
LLM_PROVIDER=gemini          # gemini | ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# === Database ===
DATABASE_URL=sqlite:///./data/lms.db

# === Vector Store ===
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2

# === Auth ===
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# === App ===
UPLOAD_DIR=./data/uploads
CORS_ORIGINS=http://localhost:3000
